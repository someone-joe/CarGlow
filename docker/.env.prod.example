# 生产环境变量模板。复制为 docker/.env.prod 并填真实值（.env.prod 已被 .gitignore，不会提交）。
STACK_ALIAS=prod
SPRING_PROFILES_ACTIVE=prod
IMAGE_TAG=1.0.0
# 应用栈在宿主机 127.0.0.1 暴露的端口（仅本机/内网，公网由 Nginx 反代进入）
APP_PORT=8081

# 强口令（务必修改）
MYSQL_ROOT_PASSWORD=__change_me__
REDIS_PASSWORD=__change_me__
TOKEN_SECRET=__change_me_random_long__

# 微信（企业认证 + 备案后填真实值；留空则退化成 dev-openid，仅联调用）
WX_APPID=
WX_SECRET=

# 支付：生产必须 wechat + 关闭 mock
PAY_PROVIDER=wechat
PAY_MOCK_ENABLED=false
# 商户号/APIv3密钥等按 WashPayService 约定追加（接真实支付时）

# 订阅消息：生产关 mock，并填微信后台申请到的模板ID
NOTIFY_MOCK_ENABLED=false
NOTIFY_TPL_ORDER_STATUS=
NOTIFY_TPL_KEY_READY=
NOTIFY_TPL_COUPON_EXPIRE=
NOTIFY_TPL_BALANCE_LOW=
NOTIFY_TPL_ACTIVITY=

# 2C4G 调优
MYSQL_BUFFER_POOL=512M
REDIS_MAXMEMORY=256mb
