# 测试环境变量模板。复制为 docker/.env.test 并使用（.env.test 已被 .gitignore）。
# 与生产完全隔离：独立项目名/卷/库；微信/支付/通知全用模拟，避免脏数据与真实扣款。
STACK_ALIAS=test
SPRING_PROFILES_ACTIVE=test
IMAGE_TAG=1.0.0
APP_PORT=8082

MYSQL_ROOT_PASSWORD=test_only_pw
REDIS_PASSWORD=test_only_pw
TOKEN_SECRET=test_only_secret

WX_APPID=
WX_SECRET=

PAY_PROVIDER=mock
PAY_MOCK_ENABLED=true
NOTIFY_MOCK_ENABLED=true

MYSQL_BUFFER_POOL=384M
REDIS_MAXMEMORY=192mb
